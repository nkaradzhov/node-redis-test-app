// Grafana Alloy configuration for receiving OTLP metrics and traces
// and forwarding them to Prometheus

// OTLP receiver for metrics and traces
otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    metrics = [otelcol.processor.batch.default.input]
    traces  = [otelcol.processor.batch.default.input]
    logs    = [otelcol.processor.batch.default.input]
  }
}

// Batch processor to improve performance
otelcol.processor.batch "default" {
  timeout          = "1s"
  send_batch_size  = 1024

  output {
    metrics = [otelcol.exporter.prometheus.default.input]
    traces  = [otelcol.exporter.otlp.tempo.input]
    logs    = [otelcol.processor.attributes.default.input]
  }
}

// Export metrics to Prometheus
otelcol.exporter.prometheus "default" {
  forward_to = [prometheus.remote_write.default.receiver]
}

// Export traces to Tempo (if you have Tempo running)
otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "http://tempo:4317"
    tls {
      insecure = true
    }
  }
}

// Prometheus remote write to send metrics to Prometheus
prometheus.remote_write "default" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

// Process logs to extract labels for Loki
otelcol.processor.attributes "default" {
  // Extract low-cardinality fields as Loki labels to enable fast filtering
  // High-cardinality fields (like metrics values, timestamps) remain in the log body for searching
  action {
    key = "loki.attribute.labels"
    action = "insert"
    value = "level, instanceId, runId, module, context"
  }

  action {
    key = "loki.resource.labels"
    action = "insert"
    value = "service.name, service.namespace"
  }

  output {
    logs = [otelcol.exporter.loki.default.input]
  }
}

// Export logs to Loki
otelcol.exporter.loki "default" {
  forward_to = [loki.write.default.receiver]
}

// Write logs to Loki
loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }

  // Ensure proper JSON handling and label processing
  external_labels = {
    job = "node-redis-test-app",
    environment = "development",
  }
}

// Logging configuration
logging {
  level  = "info"
  format = "logfmt"
}
